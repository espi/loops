# Default guardrail thresholds for loops in this control plane.
# The new-loop and loop-guardrails skills read these as defaults. Override per
# loop deliberately — raising a cap should be a conscious choice, not the norm.

# Hard stop #1 — iteration cap
LOOP_MAX_ITERATIONS=20

# Hard stop #2 — no-progress detection: bail after this many no-diff passes
LOOP_STALL_LIMIT=3

# Hard stop #3 — dollar ceiling per loop run (enforced in-harness, not billing)
LOOP_MAX_BUDGET_USD=10

# Per-iteration timeout (seconds) for a single agent turn
LOOP_TURN_TIMEOUT=600

# Per-call caps, applied to every `claude -p` invocation inside a loop, so a
# single runaway call is bounded even though the loop counter can't see it.
# Requires Claude Code v2.1.281+ (earlier, --max-turns could be ignored).
LOOP_MAX_TURNS_PER_ITER=50        # claude -p --max-turns
LOOP_ITER_TIMEOUT=1800            # wall-clock seconds per call (timeout/gtimeout)
# Native equivalent of the per-call turn cap, for runs that don't pass the flag.
# Unlike a missing flag, an invalid value is rejected at startup, not "no cap".
CLAUDE_CODE_MAX_TURNS=50

# Retry budget for a transient failing step before escalating
LOOP_MAX_RETRIES=3
